{
  "name": "japanese-vocab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "chain:parity": "node scripts/chain-parity.mjs",
    "quiz:guard": "node scripts/quiz-guard.mjs",
    "quiz:order": "node scripts/quiz-order-guard.mjs",
    "quiz:input": "node scripts/quiz-input-guard.mjs",
    "grader:guard": "node scripts/grader-guard.mjs",
    "forms:guard": "node scripts/form-names-guard.mjs",
    "owner:guard": "node scripts/owner-refresh-guard.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:changed": "playwright test --only-changed=HEAD",
    "test:e2e:failed": "playwright test --last-failed",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "framer-motion": "^13.2.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.5",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "workerd@1.20260907.1": true,
    "esbuild@0.27.0": true,
    "esbuild@0.28.1": true
  }
}
